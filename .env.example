# LLM - proxy compatível com OpenAI
# Preencha com a URL do seu proxy (ex: https://proxy.exemplo.com/v1)
LLM_BASE_URL=
LLM_MODEL=gemma4:cloud
OLLAMA_AVAILABLE_MODELS=gemma4:cloud,gpt-oss:120b,nemotron-3-ultra
# Chaves em lista separadas por vírgula (fallback automático)
OLLAMA_API_KEY=sua-chave-1,sua-chave-2,sua-chave-3

# Banco de dados (SQLite local; no Docker use Postgres via docker-compose)
DATABASE_URL=sqlite:///./data/secure_health.db

# RAG
CHROMA_PERSIST_DIR=./rag_index
LITERATURA_PATH=./data/literatura

# Segurança
CLINICAL_ALERTS_ENABLED=true
